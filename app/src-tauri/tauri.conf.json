{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sub0",
  "version": "1.0.0",
  "identifier": "app.sub0.dev",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ui",
    "beforeBuildCommand": "npm run build --prefix ui",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Sub0",
        "width": 1280,
        "height": 820,
        "minWidth": 1020,
        "minHeight": 660,
        "resizable": true,
        "visible": false,
        "backgroundColor": "#0b0b0d"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
